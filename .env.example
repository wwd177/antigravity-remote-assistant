# ============================================================================
# 反重力助手 · Antigravity Assistant (.env.example)
# 运行 `python -m qq_agy_bridge.setup_wizard --non-interactive` 可自动生成 .env 与随机强密钥
# ============================================================================

# 移动端 / Web 控制台与网络配置
WEB_PWA_ENABLED=true
WEB_PWA_HOST=0.0.0.0
WEB_PWA_PORT=8765
WEB_ACCESS_TOKEN=
CLOUDFLARE_TUNNEL_ENABLED=true
TRUST_CF_PROXY_HEADERS=false
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=

# 远控最小权限门禁（高风险能力默认关闭，可在桌面端一键临时开启或按需配置）
REMOTE_DESKTOP_ENABLED=false
REMOTE_CLIPBOARD_ENABLED=false

# GitHub Pages 加密信标（进阶自托管选配：默认关闭，避免克隆者误推上游仓库）
BEACON_ENABLED=false
BEACON_GIT_REMOTE=
BEACON_BRANCH=gh-pages

# Antigravity CLI 核心配置（留空自动查找本机已登录的 agy 可执行文件）
AGY_EXECUTABLE=agy
AGY_WORKSPACE=
AGY_MODEL=claude-sonnet-5-5-medium
AGY_FALLBACK_MODELS=claude-sonnet-5-5-medium,claude-sonnet-5-5-low,gemini-4-neon-medium,gemini-4-carbon-medium,gemini-3.8-flash-high,gpt-oss-120b-medium
QUOTA_COOLDOWN_MINUTES=60
AGY_EFFORT=
AGY_DANGEROUSLY_SKIP_PERMISSIONS=false
AGY_TIMEOUT_SECONDS=300
AGY_PREWARM=false

# 体验与自动维护
PROGRESS_NOTICE_DELAY_SECONDS=0
CACHE_CLEAN_INTERVAL_HOURS=6
AGY_SYSTEM_PROMPT_FILE=prompts/persona.md
USER_MEMORY_FILE=memory/user_profile.md
LOG_LEVEL=INFO
